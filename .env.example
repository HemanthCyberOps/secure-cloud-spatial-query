# ── Copy this file to .env and fill in your values ────────────────────────────
# cp .env.example .env

# Environment Mode  (true = Azure cloud, false = local)
IS_CLOUD=false

# Redis Configuration
# Local:  REDIS_HOST=localhost
# Docker: REDIS_HOST=redis-container
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Server Ports
SERVER_0_PORT=5000
SERVER_1_PORT=5001
SERVER_2_PORT=5002

# Internal API URLs (used by server_1 to call server_2)
# Local:  SERVER_2_URL=http://localhost:5002
# Docker: SERVER_2_URL=http://server_2:5002
SERVER_2_URL=http://localhost:5002

# Paillier keypair directory (relative to project root)
# Run: python backend/generate_keys.py  to generate keys on first setup
KEYS_DIR=keys
